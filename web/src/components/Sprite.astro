---
// Symbols drawn in Glaxnimate (web/design/glaxnimate/*.svg). Pen colors from the sources are
// kept for the Energy glyphs (they carry the type); UI icons use currentColor.
const monArt = Object.entries(import.meta.glob<string>('../../design/glaxnimate/mon-art-*.svg', { query: '?raw', import: 'default', eager: true }))
  .map(([path, raw]) => {
    const id = path.match(/mon-art-\d+/)![0];
    // Pokemon card art: the window's ground comes from CSS by type, the motif draws in currentColor
    return raw.replace(/<svg[^>]*>/, `<symbol id="${id}" viewBox="0 0 542 332">`).replace('</svg>', '</symbol>')
      .replace(/<title[^>]*>.*?<\/title>/, '').replace(/<rect id="mon-art-\d+-ground"[^>]*\/>/, '').replaceAll('#FFFFFF', 'currentColor');
  }).join('');
---
<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <symbol id="g-psychic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#8E5CF0" /><circle cx="12" cy="12" r="6.2" fill="none" stroke="#FFFFFF" stroke-width="2" /><path d="M12 9.2L14.8 12L12 14.8L9.2 12Z" fill="#FFFFFF" /></symbol>

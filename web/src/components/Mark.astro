---
// The site mark, drawn in Glaxnimate (web/design/glaxnimate/mark.svg): a hexagonal badge
// holding two played cards, one per training pool.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <path d="M61 32L46.5 57.1H17.5L3 32L17.5 6.9H46.5Z" fill="#15171C" stroke="#FFFFFF" stroke-width="4" stroke-linejoin="round" />
  <rect x="14.5" y="19.5" width="18" height="25" rx="2.6" fill="#2D7BE5" stroke="#FFFFFF" stroke-width="2.6" transform="rotate(-13 23.5 32)" />
  <rect x="30" y="17.5" width="18" height="25" rx="2.6" fill="#F6C445" stroke="#FFFFFF" stroke-width="2.6" transform="rotate(11 39 30)" />
  <rect x="33" y="21" width="12" height="4" rx="1" fill="#15171C" transform="rotate(11 39 30)" />
</svg>

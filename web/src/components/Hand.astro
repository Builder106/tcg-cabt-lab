---
// The navigation: a hand of Trainer cards, one per sort, glowing as playable. Playing one
// (following its link) slides it onto the board while the 360 games re-sort.
import { cardText } from '@/data/sorts-copy';
import SortArt from './SortArt.astro';
import { SORT_ORDER, sortPath, type SortKey } from '@/lib/sorts';
interface Props { current: SortKey }
const { current } = Astro.props;
const hand = SORT_ORDER.filter((k) => k !== current);
---
<nav class="hand" aria-label="Sort the 360 games">
  <ul class="hand__fan">
    {hand.map((k, i) => (
      <li class="hand__slot" style={`--i:${i - (hand.length - 1) / 2}`}>
        <span class="hand__glow" aria-hidden="true"></span>
        <a class="sortcard card face--trainer" href={sortPath(k)} data-resort data-flip-id={`sort-${k}`}>
          <span class="card__kind" aria-hidden="true">Trainer</span>
          <SortArt sortKey={k} />
          <span class="sortcard__name"><span class="sr-only">Sort by </span>{cardText[k].name}</span>
          <span class="sortcard__rule">{cardText[k].rule}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
